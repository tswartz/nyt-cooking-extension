{
  "name": "NYT Cooking Recipe Revealer",
  "version": "1.0",
  "description": "Reveal the best recipes",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon-30.png"
  },
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.nytimes.com/*", "http://*.nytimes.com/*"],
      "js": ["content-script.js"]
    }
  ],
  "manifest_version": 3
}
